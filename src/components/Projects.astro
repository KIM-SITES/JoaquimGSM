---
import type { ImageMetadata } from 'astro';
import { projetos, type ProjetoId } from '../data/projetos';
import fase from '../assets/projetos/fase-forma.webp';
import lamina from '../assets/projetos/lamina.webp';
import entrear from '../assets/projetos/entrear.webp';
import fase640 from '../assets/projetos/fase-forma-640.webp';
import fase960 from '../assets/projetos/fase-forma-960.webp';
import lamina640 from '../assets/projetos/lamina-640.webp';
import lamina960 from '../assets/projetos/lamina-960.webp';
import entrear640 from '../assets/projetos/entrear-640.webp';
import entrear960 from '../assets/projetos/entrear-960.webp';

const imagens = {
  'fase-forma': [fase640, fase960, fase],
  lamina: [lamina640, lamina960, lamina],
  entrear: [entrear640, entrear960, entrear],
} satisfies Record<ProjetoId, [ImageMetadata, ImageMetadata, ImageMetadata]>;

const largurasMobile = '(max-width: 350px) calc(100vw - 32px), (max-width: 900px) calc(100vw - 40px), ';
const larguraDesktop = '100vw - 2 * clamp(32px, 3.89vw, 56px)';
const tamanhos = {
  destaque: largurasMobile + '(min-width: 1432px) 756px, calc((' + larguraDesktop + ' - 24px) * 7 / 12)',
  comum: largurasMobile + '(min-width: 1432px) 540px, calc((' + larguraDesktop + ' - 24px) * 5 / 12)',
};
---
<section class="projetos" id="projetos" aria-labelledby="titulo-projetos">
  <div class="shell">
    <div class="cabecalho-secao" data-revelar>
      <p class="indice">02 / Projetos</p>
      <div class="projetos-intro">
        <h2 class="titulo-secao" id="titulo-projetos">O trabalho<br /> <em>fala por mim.</em></h2>
        <p>Três projetos demonstrativos, três identidades diferentes. Uma amostra de como penso design, comunicação e experiência para cada negócio.</p>
      </div>
    </div>

    <ul class="galeria" role="list">
      {projetos.map((projeto) => {
        const variantes = imagens[projeto.id];
        const { src, width, height } = variantes[2];
        const fontes = variantes.map((imagem) => imagem.src + ' ' + imagem.width + 'w').join(', ');
        const destaque = projeto.id === 'fase-forma';
        return (
          <li class:list={{ destaque }}>
            <article class="cartao-projeto">
              <div class="captura" data-revelar="imagem">
                <img src={src} srcset={fontes} sizes={destaque ? tamanhos.destaque : tamanhos.comum} width={width} height={height} alt={projeto.alt} loading="lazy" decoding="async" />
              </div>
              <div class="legenda">
                <div>
                  {projeto.demonstrativo && <p class="tipo">Projeto demonstrativo</p>}
                  <h3>
                    <a class="projeto" href={projeto.url} target="_blank" rel="noopener noreferrer">
                      {projeto.nome}<span class="somente-leitura"> (abre em nova aba)</span>
                    </a>
                  </h3>
                  <p class="descricao">{projeto.segmento} {projeto.descricao}</p>
                </div>
                <span class="acessar-projeto" aria-hidden="true">Acessar site <span class="seta-projeto">↗</span></span>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
    <p class="nota">Estes são estudos de portfólio criados para demonstrar abordagens visuais e funcionais em setores diferentes.</p>
  </div>
</section>

<style>
  .projetos {
    padding-block: var(--respiro);
    background:
      radial-gradient(ellipse at 88% 18%, color-mix(in srgb, var(--roxo-profundo) 55%, transparent), transparent 66%),
      linear-gradient(var(--grafite), #2b292b);
  }

  .projetos-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.875rem 2rem;
  }

  .projetos-intro em {
    font-style: normal;
    color: var(--lavanda);
  }

  .projetos-intro p {
    max-width: 19.5rem;
    color: var(--suave);
  }

  .galeria {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.5rem 1.5rem;
    border-top: 1px solid var(--linha);
    padding: 2rem 0 0;
    margin: 2rem 0 0;
    list-style: none;
  }

  .destaque {
    grid-row: span 2;
    align-self: center;
  }

  .cartao-projeto {
    position: relative;
  }

  .projeto {
    text-decoration: none;
  }

  /* A área clicável acompanha o card. O link continua nomeado pelo título. */
  .projeto::after {
    position: absolute;
    inset: 0;
    border-radius: 0.25rem;
    content: '';
  }

  .projeto:focus-visible {
    outline: none;
  }

  .projeto:focus-visible::after {
    outline: 3px solid var(--foco);
    outline-offset: 4px;
  }

  .captura {
    overflow: hidden;
    border: 1px solid var(--linha);
    border-radius: 0.25rem;
    background: var(--painel);
  }

  .captura img {
    width: 100%;
    height: auto;
  }

  .legenda {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.375rem 1rem;
    padding-block-start: 0.875rem;
  }

  .tipo {
    color: var(--lavanda);
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h3 {
    margin-block: 0.25rem;
    font-size: clamp(1.3125rem, 2vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .descricao, .nota {
    color: var(--suave);
    font-size: 0.9375rem;
  }

  .acessar-projeto {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    color: var(--texto);
    font-size: 0.8125rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .seta-projeto {
    color: var(--lavanda);
    font-size: 0.9375rem;
  }

  .nota {
    margin-block-start: 2.125rem;
    max-width: 36rem;
  }

  @media (max-width: 900px) {
    .projetos-intro p {
      max-width: 33rem;
    }

    .galeria {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.125rem;
      padding-block-start: 0;
      margin-block-start: 1.5rem;
      border-top: 0;
    }

    .nota {
      margin-block-start: 1.5rem;
    }

    .destaque {
      grid-row: auto;
    }
  }

  @media (max-width: 430px) {
    .legenda {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
