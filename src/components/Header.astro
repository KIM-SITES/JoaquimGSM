---
import { whatsapp } from '../data/contato';
---
<header class="site-header">
  <div class="shell barra">
    <a class="marca" href="#inicio" aria-label="JM/ Joaquim Moura, voltar ao início">
      <span class="monograma" aria-hidden="true">JM<span>/</span></span>
      <span class="assinatura" aria-hidden="true">Joaquim Moura</span>
    </a>
    <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-principal" hidden>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <nav id="menu-principal" aria-label="Navegação principal">
      <a href="#projetos" tabindex="0">Projetos</a>
      <a href="#sobre" tabindex="0">Sobre</a>
      <a href="#processo" tabindex="0">Processo</a>
      <a class="link-contato" href="#contato" tabindex="0">Contato</a>
    </nav>
    <a class="header-contato" href={whatsapp.url} target="_blank" rel="noopener noreferrer">
      Vamos conversar <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('.site-header');
    const botao = header?.querySelector('.menu-toggle');
    const menu = document.getElementById('menu-principal');
    if (!header || !botao || !menu) return;

    const telaMovel = matchMedia('(max-width: 900px)');

    function atualizarMenu(aberto) {
      botao.setAttribute('aria-expanded', String(aberto));
      botao.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
      menu.hidden = telaMovel.matches && !aberto;
    }

    function ajustarAoViewport() {
      const foco = document.activeElement;
      atualizarMenu(false);
      if (telaMovel.matches && menu.contains(foco)) botao.focus();
      if (!telaMovel.matches && (foco === botao || foco?.classList.contains('link-contato'))) {
        menu.querySelector('a')?.focus();
      }
    }

    botao.addEventListener('click', () => atualizarMenu(menu.hidden));

    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && telaMovel.matches && !menu.hidden) {
        atualizarMenu(false);
        botao.focus();
      }
    });

    menu.addEventListener('click', (event) => {
      const link = event.target.closest('a[href^="#"]');
      if (!telaMovel.matches || !link) return;
      const destino = document.getElementById(link.hash.slice(1));
      if (destino) {
        destino.setAttribute('tabindex', '-1');
        destino.focus({ preventScroll: true });
      }
      atualizarMenu(false);
    });

    header.addEventListener('focusout', (event) => {
      if (event.relatedTarget && !header.contains(event.relatedTarget)) atualizarMenu(false);
    });

    telaMovel.addEventListener('change', ajustarAoViewport);
    header.setAttribute('data-menu-pronto', '');
    botao.hidden = false;
    ajustarAoViewport();
  })();
</script>

<style>
  .site-header {
    position: relative;
    z-index: 2;
    background: var(--grafite);
    border-bottom: 1px solid var(--linha);
  }

  .barra {
    min-height: 4.6875rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0 2rem;
  }

  .marca, nav a, .header-contato {
    display: inline-flex;
    min-block-size: 2.75rem;
    align-items: center;
    text-decoration: none;
  }

  .marca {
    gap: 1rem;
  }

  .monograma {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.12em;
    line-height: 1;
    white-space: nowrap;
  }

  .monograma span {
    margin-inline-start: 0.25rem;
    color: var(--amarelo);
    font-weight: 500;
  }

  .assinatura {
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  nav a {
    min-inline-size: 2.75rem;
    justify-content: center;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin-inline-start: auto;
    font-size: 0.875rem;
  }

  .header-contato {
    justify-content: center;
    gap: 1rem;
    padding: 0.55rem 0.875rem;
    border: 1px solid var(--borda-controle);
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .header-contato span {
    color: var(--amarelo);
  }

  nav .link-contato {
    display: none;
  }

  .menu-toggle {
    display: none;
    min-width: 2.75rem;
    min-height: 2.75rem;
    align-content: center;
    justify-items: center;
    gap: 0.375rem;
    padding: 0.5rem;
    border: 1px solid var(--borda-controle);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--texto);
    cursor: pointer;
  }

  .menu-toggle span {
    width: 1.125rem;
    height: 2px;
    background: currentColor;
  }

  .menu-toggle[aria-expanded="true"] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .barra {
      min-height: 3.9375rem;
      column-gap: 0.75rem;
    }

    .marca {
      gap: 0.875rem;
    }

    .monograma {
      font-size: 1.625rem;
    }

    nav {
      flex-basis: 100%;
      gap: 0 1rem;
      margin: 0;
    }

    .menu-toggle {
      display: grid;
    }

    .site-header[data-menu-pronto] nav {
      position: absolute;
      inset: 100% 0 auto;
      display: grid;
      padding: 0.5rem var(--margem) 0.875rem;
      background: var(--grafite);
      border-bottom: 1px solid var(--linha);
    }

    .site-header[data-menu-pronto] nav a {
      justify-content: flex-start;
    }

    .site-header[data-menu-pronto] nav a + a {
      border-top: 1px solid var(--linha);
    }

    nav .link-contato {
      display: inline-flex;
    }

    .header-contato {
      display: none;
    }
  }
</style>
