---
import { retrato } from '../data/retrato';
---
<img
  class="retrato"
  {...retrato}
  alt="Retrato de Joaquim Moura"
  fetchpriority="high"
/>

<style>
  .retrato {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
  }

  @media (width > 900px) {
    .retrato {
      grid-area: 1 / 2;
      align-self: center;
      justify-self: end;
      width: min(100%, 64rem);
      aspect-ratio: 4 / 3;
      object-fit: cover;
      object-position: center;
    }
  }
</style>
