---
const ano = new Date().getFullYear();
---
<footer>
  <div class="shell rodape">
    <p>© {ano} Joaquim Moura</p>
    <p>Design, desenvolvimento e uma boa conversa.</p>
    <a href="#inicio">Voltar ao topo <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--linha);
    color: var(--suave);
  }

  .rodape {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: 4.875rem;
    padding-block: 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    color: var(--texto);
    text-decoration: none;
  }

  a span {
    color: var(--amarelo);
  }

  @media (max-width: 600px) {
    .rodape {
      flex-direction: column;
      align-items: start;
      gap: 0.375rem;
      padding-block: 1.25rem 0.75rem;
    }
  }
</style>
