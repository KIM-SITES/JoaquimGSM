---
import { retrato } from '../data/retrato';
---
<img
  class="retrato"
  {...retrato}
  alt="Retrato de Joaquim Moura"
  fetchpriority="high"
/>

<style>
  .retrato {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
  }

  @media (width > 900px) {
    .retrato {
      position: absolute;
      inset: 0;
      height: 100%;
      object-fit: cover;
      object-position: center top;
    }
  }
</style>
